{
  "manifest_version": 3,
  "name": "JobFill AI — One-Click Job & Internship Autofiller",
  "version": "1.2.0",
  "description": "Autofills job and internship applications with AI question copilot on Workday, Greenhouse, Lever, Ashby, ADP, and any career portal in 1-click.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobFill AI — Autofill Application",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "profile-data.js",
        "ai-copilot.js",
        "sites/greenhouse.js",
        "sites/tiktok.js",
        "sites/workday.js",
        "sites/lever.js",
        "sites/ashby.js",
        "sites/adp.js",
        "sites/universal.js",
        "autofill-core.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["resume-sync/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
